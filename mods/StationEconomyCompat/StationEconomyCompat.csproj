<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StationEconomyCompat</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- GUIStyle and GUIContent, for measuring translated previews. -->
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../Shared/Incompatible.cs" Link="Incompatible.cs" />
    <Compile Include="../Shared/Notes.cs" Link="Notes.cs" />
    <Compile Include="../Shared/OptionsMenu.cs" Link="OptionsMenu.cs" />
    <Compile Include="../Shared/TextTable.cs" Link="TextTable.cs" />
    <!-- Only language tables: station_economy_additions.csv belongs to the other translator. -->
    <EmbeddedResource Include="dist/Localization/en.csv" LogicalName="Localization/en.csv" />
  </ItemGroup>
  <ItemGroup>
    <!-- Canvas, for the phone's layer. -->
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <!-- The phone's texts. -->
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
